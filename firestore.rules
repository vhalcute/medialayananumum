rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check ping
    match /system_health/{id} {
      allow read, write: if true;
    }

    // Admin Users Collection
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Employee Advocacy Monitoring Collection
    match /employee_advocacy/{recordId} {
      allow read, write: if true;
    }

    // Performance Milestones / Schedule Collection
    match /performance_milestones/{milestoneId} {
      allow read, write: if true;
    }

    // General app settings and bookings
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
